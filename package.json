{
  "name": "mvw-search-index",
  "version": "3.0.2",
  "description": "Module to generate the search index using lunr.",
  "keywords": [
    "website",
    "search",
    "index",
    "lunr",
    "static",
    "hugo",
    "jekyll",
    "gatsby"
  ],
  "license": "MIT",
  "author": {
    "name": "tiliavir",
    "email": "tiliavir@gmail.com"
  },
  "bin": {
    "mvw-search-index": "js/cli.js"
  },
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "files": [
    "js/**/*.js",
    "js/**/*.d.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/lunr": "2.3.7",
    "@types/node": "26.6.6",
    "serve": "14.2.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "glob": "14.0.4",
    "lunr": "2.3.9",
    "lunr-languages": "1.24.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p ./ts",
    "lint": "biome check . && tsc -p spec",
    "test": "npm run lint && npm run build && vitest run",
    "preserve": "node js/cli.js '**/*.html' docs/index.json 'body.to-be-indexed' --cwd docs",
    "serve": "serve docs",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiliavir/mvw-search-index.git"
  },
  "bugs": {
    "url": "https://github.com/tiliavir/mvw-search-index/issues"
  },
  "homepage": "https://github.com/tiliavir/mvw-search-index#readme",
  "//": "overrides.compression: serve@14.2.x pins compression@1.8.1 (GHSA memory-leak DoS). Remove this override once serve depends on compression >=1.8.2.",
  "overrides": {
    "compression": "1.8.2"
  }
}
